# CivicFix AI Environment Variables

# Database: SQLite for zero-config local run, or PostgreSQL (Supabase / Neon / RDS)
DATABASE_URL="file:./dev.db"

# Authentication JWT Secret (min 32 characters for production)
JWT_SECRET="civicfix_ai_jwt_secret_super_secure_key_2026_production"

# Google Gemini API Key for AI Complaint Analysis & Categorization
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""

# Transactional Email Provider (Resend or SMTP)
# Obtain from: https://resend.com/
RESEND_API_KEY=""
EMAIL_FROM="CivicFix AI <notifications@civicfix.ai>"

# Google Maps Platform Key (optional - OpenStreetMap / Leaflet is active by default)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
