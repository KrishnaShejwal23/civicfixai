// CivicFix AI Prisma Database Schema
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  fullName      String
  passwordHash  String
  role          String    @default("CITIZEN") // "CITIZEN" | "ADMIN"
  emailVerified Boolean   @default(false)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  complaints       Complaint[]
  savedAddresses   SavedAddress[]
  statusHistories  ComplaintStatusHistory[]
  emailRecords     EmailRecord[]
  auditLogs        AdminAuditLog[]

  @@index([email])
}

model Complaint {
  id              String    @id @default(cuid())
  refNumber       String    @unique // e.g. CF-2026-9812
  userId          String
  category        String    // Roads & Transport, Garbage & Sanitation, Water & Drainage, etc.
  subcategory     String    // Potholes, Broken streetlights, etc.
  title           String
  description     String
  photoUrl        String?   // Base64 or stored URL
  photoName       String?
  
  // Location
  address         String
  building        String?
  street          String?
  area            String?
  landmark        String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?

  // AI Analysis Metadata
  aiAnalysis      String?   // JSON string of AI structured output
  aiSuggested     Boolean   @default(false)

  // Official Status & Priority
  priority        String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  status          String    @default("SUBMITTED") // "SUBMITTED" | "PENDING" | "IN_PROGRESS" | "RESOLVED" | "REJECTED" | "REOPENED"
  adminNotes      String?
  
  // Department Assignment
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory   ComplaintStatusHistory[]
  emailRecords    EmailRecord[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([refNumber])
}

model ComplaintStatusHistory {
  id            String    @id @default(cuid())
  complaintId   String
  status        String
  notes         String?
  changedById   String
  createdAt     DateTime  @default(now())

  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy     User      @relation(fields: [changedById], references: [id])

  @@index([complaintId])
}

model Department {
  id                  String    @id @default(cuid())
  name                String    // e.g. Municipal Road Maintenance Division
  categoryType        String    // ROADS, SANITATION, WATER, ELECTRICITY, PARKS, HAZARDS, GENERAL
  jurisdiction        String    // e.g. Central Municipal Zone, Citywide, Ward 12
  email               String
  phone               String?
  verificationSource  String    // e.g. Official Municipal Gazette 2026, Municipal Portal Directory
  isVerified          Boolean   @default(true)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  complaints          Complaint[]
  emailRecords        EmailRecord[]
}

model EmailRecord {
  id                String    @id @default(cuid())
  complaintId       String
  userId            String
  departmentId      String?
  recipientEmail    String
  recipientName     String
  isVerified        Boolean   @default(true)
  subject           String
  bodyText          String
  providerMessageId String?
  sendStatus        String    @default("DRAFT") // "DRAFT" | "SENDING" | "ACCEPTED" | "FAILED" | "DELIVERED"
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  complaint         Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department? @relation(fields: [departmentId], references: [id])

  @@index([complaintId])
  @@index([userId])
  @@index([sendStatus])
}

model SavedAddress {
  id          String    @id @default(cuid())
  userId      String
  label       String    // "Home", "Work", "Office", "Parents' Place"
  building    String?
  street      String
  area        String
  landmark    String?
  city        String
  state       String
  pincode     String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminId     String
  action      String    // "STATUS_UPDATE", "DEPARTMENT_ASSIGN", "DEPARTMENT_CREATE", etc.
  targetType  String    // "COMPLAINT", "DEPARTMENT", "USER"
  targetId    String
  details     String?   // JSON or text
  createdAt   DateTime  @default(now())

  admin       User      @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}
